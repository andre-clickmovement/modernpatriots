{
  "name": "conservativeresearchgroup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation sh -c 'yes | payload migrate' && cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "tsx scripts/seed-payload.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "recategorize": "tsx scripts/recategorize-posts.ts",
    "wp-export": "tsx scripts/wp-export-to-json.ts",
    "reimport-content": "tsx scripts/reimport-post-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@payloadcms/db-postgres": "^3.49.1",
    "@payloadcms/next": "^3.49.1",
    "@payloadcms/richtext-lexical": "^3.49.1",
    "@payloadcms/storage-vercel-blob": "^3.49.1",
    "@payloadcms/ui": "^3.49.1",
    "cross-env": "^7.0.3",
    "fast-xml-parser": "^4.5.3",
    "graphql": "^16.11.0",
    "jsdom": "^26.1.0",
    "next": "15.4.11",
    "payload": "^3.49.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
