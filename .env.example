# Database (Neon/Supabase pooled connection string recommended for production)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/crg

# Payload encryption secret (32+ random characters)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# AI agent endpoint auth
AGENT_API_KEY=change-me-agent-api-key

# Vercel Blob (optional for local dev — uploads use local /media folder without this)
BLOB_READ_WRITE_TOKEN=

# Claude API (optional — only needed for on-device content generation)
ANTHROPIC_API_KEY=

# On-demand ISR revalidation
REVALIDATION_SECRET=change-me-revalidation-secret

# Cron auth (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=change-me-cron-secret
